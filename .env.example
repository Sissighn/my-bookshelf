# Copy this file to .env.local. Use these VITE_ names with the public values
# from Supabase → Connect, then restart Vite.
# URL format: https://your-project.supabase.co
VITE_SUPABASE_URL=
# Key format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public Turnstile site key. Configure its secret in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
