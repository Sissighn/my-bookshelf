{
  "name": "my-bookshelf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mac": "node scripts/build-mac.mjs",
    "lint": "oxlint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mac": "playwright test --config=playwright.mac.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/supabase-js": "^2.119.2",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.12",
    "electron": "45.4.1",
    "fake-indexeddb": "6.2.8",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "4.1.12"
  }
